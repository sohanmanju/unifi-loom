    {
      "name": "prepare_ap_radio_change",
      "description": "Preview channel, width, transmit power or minimum RSSI changes. Use apply_change for human approval.",
      "inputSchema": {
        "$defs": {
          "RadioEdit": {
            "additionalProperties": false,
            "properties": {
              "channel": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "const": "auto",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Channel"
              },
              "channel_width_mhz": {
                "anyOf": [
                  {
                    "enum": [
                      20,
                      40,
                      80,
                      160,
                      320
                    ],
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Channel Width Mhz"
              },
              "power_mode": {
                "anyOf": [
                  {
                    "enum": [
                      "auto",
                      "low",
                      "medium",
                      "high",
                      "custom"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Power Mode"
              },
              "transmit_power_dbm": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Transmit Power Dbm"
              },
              "min_rssi_enabled": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Min Rssi Enabled"
              },
              "min_rssi_dbm": {
                "anyOf": [
                  {
                    "maximum": -1,
                    "minimum": -100,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Min Rssi Dbm"
              }
            },
            "title": "RadioEdit",
            "type": "object"
          }
        },
        "properties": {
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "radio_name": {
            "title": "Radio Name",
            "type": "string"
          },
          "settings": {
            "$ref": "#/$defs/RadioEdit"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "site": {
            "default": "default",
            "title": "Site",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "radio_name",
          "settings",
          "reason"
        ],
        "title": "prepare_ap_radio_changeArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
