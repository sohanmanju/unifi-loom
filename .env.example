# Local console origin, not a Cloud Connector URL.
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=
# Trust the console certificate/CA. TLS verification stays enabled.
UNIFI_CA_CERT=
# Optional certificate DNS name when connecting by IP (CA certificate required).
UNIFI_TLS_SERVER_NAME=
UNIFI_ALLOW_WRITES=false
# Internal session adapter is opt-in. Use a local Network automation account.
UNIFI_INTERNAL_ENABLED=false
# session or api_key; API-key mode needs no username/password or MFA login.
UNIFI_INTERNAL_AUTH=session
UNIFI_USERNAME=
UNIFI_PASSWORD=
# Use an absolute private directory in a real deployment.
UNIFI_STATE_DIR=work/unifi-state
UNIFI_SPEC_FILE=
UNIFI_INTERNAL_MANIFEST=
